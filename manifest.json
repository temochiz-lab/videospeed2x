{
  "manifest_version": 2,
  "name": "Video Speed Booster",
  "version": "1.1.3",
  "description": "動画の現在の再生速度を表示し、2倍・1.5倍・1倍に切り替えます",
  "permissions": [
    "activeTab",
    "tabs",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "storage"
  ],
  "browser_action": {
    "default_icon": {
      "16": "icon-16-1.png",
      "32": "icon-32-1.png",
      "48": "icon-48-1.png"
    },
    "default_title": "現在の速度は1倍"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "64": "icon-64.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png"
  },
  "commands": {
    "toggle-speed": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "動画の再生速度を切り替える"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{91f73750-e69d-4c9b-b155-aca85c802016}",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
